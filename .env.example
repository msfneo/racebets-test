# Copy to .env to override the defaults baked into docker-compose.yml.
# The application reads these from the environment; .env is only read when you
# run outside of Docker.

APP_ENV=dev
APP_PORT=8080

DB_HOST=db
DB_PORT=3306
DB_NAME=wallet
DB_TEST_NAME=wallet_test
DB_USER=wallet
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# Host port the MySQL container is published on (for GUI clients).
DB_EXPOSED_PORT=13306
